{
	"name": "Forums",
	"description": "Execution Project - Forums",
	"author": "Advanced Electronics Company Ltd",
	"scripts": {
		"build": "npm run build-vendor:prod && npm run build:prod",
		"build-vendor:dev": "webpack --config webpack.config.vendor.js --progress --mode=development --env.NODE_ENV=development --env.ASPNETCORE_ENVIRONMENT=development",
		"build-vendor:prod": "webpack --config webpack.config.vendor.js --progress --mode=production --env.NODE_ENV=production --env.ASPNETCORE_ENVIRONMENT=production",
		"build-watch:dev": "webpack --progress --hide-modules --watch  --mode=development  --env.NODE_ENV=development --env.ASPNETCORE_ENVIRONMENT=development",
		"build:dev": "webpack --env.NODE_ENV=development --progress --hide-modules --mode=development ",
		"build:prod": "webpack --progress --hide-modules --mode=production --env.NODE_ENV=production",
		"dev": "npm run build-vendor:dev && npm run build:dev",
		"install": "npm run build-vendor:dev",
		"lint": "eslint src/**/*.{js,vue}",
		"lint-fix": "eslint src/**/*.{js,vue} --fix",
		"watch": "npm run build-vendor:dev && npm run build-watch:dev"
	},
